{
  "version": 2,
  "installCommand": "npm install --package-lock=false --registry=https://registry.npmjs.org --replace-registry-host=always",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/mock" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
